dav 1
title "tiny-orders architecture"

node browser "Browser" [icon: browser, sub: "Customer"]

group edge "Web" [color: teal] {
  node web "nginx" [icon: lb, sub: "Static files, /api proxy"]
}

group backend "Backend" [color: blue] {
  node api "Order API" [icon: api, sub: "Node.js :3000"]
  node worker "Email worker" [icon: function, sub: "Node.js"]
}

group data "Data and messaging" [color: green] {
  node postgres "PostgreSQL" [icon: database, sub: "Orders, stock"]
  node redis "Redis" [icon: cache, sub: "Product cache"]
  node rabbit "RabbitMQ" [icon: queue, sub: "orders exchange"]
}

group external "External services" [color: purple] {
  node psp "Payment provider" [icon: payment, sub: "payments.example.com"]
  node smtp "SMTP server" [icon: mail, sub: "smtp.example.com"]
}

browser <-> web : "HTTP :8080"
web <-> api : "/api/ proxy"
api <-> postgres : "SQL"
api --> redis : "Invalidate cache"
api <-> psp : "POST /charges"
api --> rabbit : "order.confirmed"
rabbit --> worker : "order-emails queue"
worker --> smtp : "Send mail"
api --> api : "Retry with backoff" [id: e_retry]

step "Place an order" {
  desc "The customer submits an order. The API validates it and passes it on."
  animate browser --> web : "Checkout" [icon: file]
  animate web --> api : "POST /api/orders" [icon: file]
}

step "Reserve stock" {
  desc "In one transaction the API decrements stock and records the order as pending."
  state postgres [badge: "pending", color: yellow]
  animate api --> postgres : "Reserve stock, insert order" [desc: "Out-of-stock items return 409"]
  animate api --> redis : "Invalidate products"
}

step "Charge the provider" {
  desc "The API charges the provider with the order id as the idempotency key."
  state psp [badge: "200 OK", color: green]
  animate api --> psp : "Charge" [icon: payment]
  animate psp --> api : "Payment id" [icon: key, color: green]
}

step "Mark paid and publish" {
  desc "The order is saved as paid and an order.confirmed event is published and confirmed by the broker."
  state postgres [badge: "paid", color: green]
  state psp [badge: "", color: none]
  animate api --> postgres : "status = paid"
  animate api --> rabbit : "order.confirmed" [icon: mail]
}

step "Send the confirmation email" {
  desc "The worker consumes the event and emails the customer, then returns the response."
  animate rabbit --> worker : "order.confirmed" [icon: mail]
  animate worker --> smtp : "Confirmation" [icon: mail]
  animate api --> web : "201 Created" [color: green]
  animate web --> browser : "Order confirmed" [color: green]
}

step "Provider is down" {
  desc "The order is pending and stock is reserved. The provider times out or returns 5xx."
  state postgres [badge: "pending", color: yellow]
  state psp [badge: "503", color: red]
  animate browser --> web : "Checkout" [icon: file]
  animate web --> api : "POST /api/orders" [icon: file]
  animate api --> psp : "Attempt 1" [icon: payment, color: red, desc: "3 s timeout, 5xx, or network error"]
}

step "Retries fail" {
  desc "The API makes three attempts in total, waiting about 200 ms and then 400 ms plus jitter. The same idempotency key is used, so nothing is charged twice."
  state psp [badge: "503", color: red]
  animate api --> api : "Wait, then attempt 2" [color: orange]
  animate api --> psp : "Attempt 2" [icon: payment, color: red]
  animate api --> api : "Wait, then attempt 3" [color: orange]
  animate api --> psp : "Attempt 3" [icon: payment, color: red]
}

step "Order fails" {
  desc "Retries are exhausted. The order is marked payment_failed, the stock goes back, and the customer gets a 503. No event is published, so no email is sent."
  state postgres [badge: "payment_failed", color: red]
  animate api --> postgres : "Mark failed, restore stock" [color: red]
  animate api --> redis : "Invalidate products"
  animate api --> web : "503 Unavailable" [color: red]
  animate web --> browser : "Payment failed" [color: red]
}
