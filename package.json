{
  "name": "dynamic-architect-viewer-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "npm --workspace=apps/vscode run dev",
    "build": "npm --workspace=apps/vscode run build",
    "package": "npm --workspace=apps/vscode run package",
    "preview": "npm --workspace=apps/vscode run preview",
    "typecheck": "npm --workspace=apps/vscode run typecheck",
    "test": "npm --workspace=apps/vscode run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.5"
    }
  }
}
