{
  "name": "dynamic-architect-viewer",
  "displayName": "DynamicArchitectViewer",
  "description": "Time-stepped architecture & screen-transition diagram DSL (.dav) with two-way interactive canvas and zero-dependency single-file HTML export.",
  "version": "0.1.0",
  "publisher": "dynamic-architect-viewer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:dav",
    "onCommand:dav.openPreview",
    "onCommand:dav.exportHtml",
    "onCommand:dav.importHtml",
    "onCommand:dav.newFromTemplate"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "dav",
        "aliases": [
          "DynamicArchitectViewer DSL",
          "dav"
        ],
        "extensions": [
          ".dav"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dav",
        "scopeName": "source.dav",
        "path": "./syntaxes/dav.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dav.openPreview",
        "title": "Open Canvas Preview to the Side",
        "category": "DynamicArchitectViewer",
        "icon": "$(open-preview)"
      },
      {
        "command": "dav.exportHtml",
        "title": "Export Standalone HTML",
        "category": "DynamicArchitectViewer",
        "icon": "$(export)"
      },
      {
        "command": "dav.importHtml",
        "title": "Extract DSL from Standalone HTML...",
        "category": "DynamicArchitectViewer"
      },
      {
        "command": "dav.newFromTemplate",
        "title": "New Diagram from Sample Template...",
        "category": "DynamicArchitectViewer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dav.openPreview",
          "when": "editorLangId == dav",
          "group": "navigation@1"
        },
        {
          "command": "dav.exportHtml",
          "when": "editorLangId == dav",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dav.openPreview",
          "when": "editorLangId == dav"
        },
        {
          "command": "dav.exportHtml",
          "when": "editorLangId == dav"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dav.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && editorLangId == dav"
      }
    ]
  },
  "scripts": {
    "build:runtime": "vite build --config vite.runtime.config.ts --logLevel warn",
    "build:webview": "vite build --config vite.config.ts --logLevel warn",
    "build:extension": "vite build --config vite.extension.config.ts --logLevel warn",
    "dev": "npm run build:runtime && vite",
    "build": "npm run build:runtime && npm run build:webview && npm run build:extension",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:runtime && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lezer/common": "^1.5.5",
    "@lezer/lr": "^1.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.96.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
