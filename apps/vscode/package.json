{
  "name": "dynamic-architect-viewer",
  "displayName": "Dynamic Architect Viewer",
  "description": "Write architecture and screen-flow diagrams as text, play them step by step, and export them as a standalone HTML file or an animated SVG.",
  "version": "1.0.0",
  "publisher": "osg-junue",
  "icon": "media/icon.png",
  "license": "MIT",
  "keywords": [
    "DynamicArchitectViewer",
    "dav",
    "diagram",
    "architecture",
    "diagram-as-code",
    "flowchart",
    "sequence",
    "sequence-diagram",
    "screen-flow",
    "data-flow",
    "system-design",
    "animation",
    "step-by-step",
    "visualization",
    "dsl",
    "live-preview",
    "html-export",
    "svg-export",
    "dynamic",
    "architect",
    "viewer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Osg-Junue/DynamicArchitectViewer.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:dav",
    "onWebviewPanel:dav.canvasPreview"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "dav",
        "aliases": [
          "DynamicArchitectViewer DSL",
          "dav"
        ],
        "extensions": [
          ".dav"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/file-icon-light.svg",
          "dark": "./media/file-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dav",
        "scopeName": "source.dav",
        "path": "./syntaxes/dav.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dav.openPreview",
        "title": "%command.openPreview.title%",
        "category": "DynamicArchitectViewer",
        "icon": "$(open-preview)"
      },
      {
        "command": "dav.exportHtml",
        "title": "%command.exportHtml.title%",
        "category": "DynamicArchitectViewer",
        "icon": "$(export)"
      },
      {
        "command": "dav.exportSvg",
        "title": "%command.exportSvg.title%",
        "category": "DynamicArchitectViewer"
      },
      {
        "command": "dav.importHtml",
        "title": "%command.importHtml.title%",
        "category": "DynamicArchitectViewer"
      },
      {
        "command": "dav.newFromTemplate",
        "title": "%command.newFromTemplate.title%",
        "category": "DynamicArchitectViewer"
      },
      {
        "command": "dav.copyAiPrompt",
        "title": "%command.copyAiPrompt.title%",
        "category": "DynamicArchitectViewer",
        "icon": "$(sparkle)"
      },
      {
        "command": "dav.installAgentSkill",
        "title": "%command.installAgentSkill.title%",
        "category": "DynamicArchitectViewer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dav.openPreview",
          "when": "editorLangId == dav || resourceExtname == .dav",
          "group": "navigation@1"
        },
        {
          "command": "dav.exportHtml",
          "when": "editorLangId == dav || resourceExtname == .dav",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dav.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == dav || resourceExtname == .dav"
      }
    ]
  },
  "scripts": {
    "build:runtime": "vite build --config vite.runtime.config.ts --logLevel warn",
    "build:webview": "vite build --config vite.config.ts --logLevel warn",
    "build:extension": "vite build --config vite.extension.config.ts --logLevel warn",
    "build:skill": "vite build --config vite.skill.config.ts --logLevel warn && vite build --config vite.skill.config.ts --mode reading --logLevel warn",
    "build:cli": "vite build --config vite.cli.config.ts --logLevel warn",
    "dev": "npm run build:runtime && vite",
    "build": "npm run build:runtime && npm run build:webview && npm run build:extension && npm run build:skill && npm run build:cli",
    "package": "npm run build && vsce package --no-dependencies --baseContentUrl https://github.com/Osg-Junue/DynamicArchitectViewer/blob/HEAD/apps/vscode --baseImagesUrl https://github.com/Osg-Junue/DynamicArchitectViewer/raw/HEAD/apps/vscode -o dist/dynamic-architect-viewer.vsix",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:runtime && npm run build:skill && npm run build:cli && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lezer/common": "^1.5.5",
    "@lezer/lr": "^1.4.12"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.1.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
