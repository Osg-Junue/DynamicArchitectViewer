{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DynamicArchitectViewer DSL",
  "scopeName": "source.dav",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#booleans" },
    { "include": "#arrows" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dav",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dav",
          "match": "\\b(?:dav|title|group|node|step|desc|focus|state|animate)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.dav",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "arrows": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.dav",
          "match": "<->|<\\.>|-->|\\.\\.>"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.dav",
          "match": "-?\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.dav",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dav",
          "match": "\\\\[\\\\\"nt]"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "\\b(color)\\s*(:)\\s*((?i:red|orange|yellow|green|teal|blue|purple|pink|gray|none))\\b",
          "captures": {
            "1": { "name": "variable.other.property.dav" },
            "2": { "name": "punctuation.separator.key-value.dav" },
            "3": { "name": "constant.other.color.dav" }
          }
        },
        {
          "match": "\\b(icon)\\s*(:)\\s*((?i:server|container|function|database|cache|queue|storage|lb|firewall|cdn|cloud|router|external|auth|ai|mail|monitor|schedule|search|screen|modal|browser|mobile|terminal|user))\\b",
          "captures": {
            "1": { "name": "variable.other.property.dav" },
            "2": { "name": "punctuation.separator.key-value.dav" },
            "3": { "name": "support.constant.icon.dav" }
          }
        },
        {
          "match": "\\b(icon|sub|badge|color|visible|parallel|desc|id)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.property.dav" },
            "2": { "name": "punctuation.separator.key-value.dav" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.dav",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
