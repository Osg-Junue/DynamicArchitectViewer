title "05 マルチリージョン: 対称構成とレプリケーション"

// Two zones of the same shape, joined by replication.

group global "グローバル" [color: teal] {
  node user "利用者" [icon: users, sub: "国内 / 海外"]
  node dns "DNS" [icon: router, sub: "Route 53"]
  node cdn "CDN" [icon: cdn, sub: "CloudFront"]
  node health "ヘルスチェック" [icon: monitor, sub: "30秒間隔"]
}

group tokyo "東京リージョン (主)" [color: blue] {
  node t_lb "ロードバランサー" [icon: lb, sub: "ALB"]
  node t_app1 "アプリ A" [icon: container, sub: "ECS / AZ-a"]
  node t_app2 "アプリ B" [icon: container, sub: "ECS / AZ-c"]
  node t_cache "キャッシュ" [icon: cache, sub: "Redis"]
  node t_db "DB プライマリ" [icon: database, sub: "Aurora"]
  node t_q "キュー" [icon: queue, sub: "SQS"]
}

group osaka "大阪リージョン (副)" [color: green] {
  node o_lb "ロードバランサー" [icon: lb, sub: "ALB"]
  node o_app1 "アプリ A" [icon: container, sub: "ECS / AZ-a"]
  node o_app2 "アプリ B" [icon: container, sub: "ECS / AZ-c"]
  node o_cache "キャッシュ" [icon: cache, sub: "Redis"]
  node o_db "DB レプリカ" [icon: database, sub: "Aurora Global"]
  node o_q "キュー" [icon: queue, sub: "SQS"]
}

group shared "共有サービス" [color: purple] {
  node s3 "オブジェクト保管" [icon: storage, sub: "S3 CRR"]
  node secret "シークレット" [icon: key, sub: "Secrets Manager"]
  node ci "デプロイ" [icon: runtime, sub: "GitHub Actions"]
  node obs "監視" [icon: monitor, sub: "CloudWatch"]
}

group dr "バックアップ / DR" [color: orange] {
  node vault "バックアップ保管" [icon: storage, sub: "AWS Backup"]
  node cold "コールドDB" [icon: database, sub: "日次スナップショット"]
  node runbook "切替手順" [icon: terminal, sub: "Runbook"]
  node sre "当番" [icon: user, sub: "SRE"]
}

step "通常トラフィック（東京リージョン）" {
  static dns ..> o_lb : "重み 0 (待機)"
  static health ..> t_lb : "監視"
  static health ..> o_lb : "監視"
  static ci ..> t_app1 : "デプロイ"
  static ci ..> o_app1 : "デプロイ"
  static t_app2 ..> secret : "取得"
  static o_app2 ..> secret : "取得"
  animate user --> dns : "名前解決"
  animate user --> cdn : "HTTPS" [parallel: true]
  animate dns --> t_lb : "重み 100"
  animate cdn --> t_lb : "オリジン"
  animate t_lb --> t_app1 : "HTTP"
  animate t_lb --> t_app2 : "HTTP" [parallel: true]
  animate t_app1 --> t_cache : "GET"
  animate t_app2 --> t_cache : "GET" [parallel: true]
  animate t_app1 --> t_db : "SQL"
  animate t_app2 --> t_db : "SQL" [parallel: true]
  animate t_app1 --> t_q : "ジョブ"
  animate t_app1 --> s3 : "アップロード"
  animate t_db --> o_db : "レプリケーション"
  animate t_db --> vault : "スナップショット"
  animate vault --> cold : "復元"
}

step "フェイルオーバーと大阪リージョン処理" {
  animate health --> dns : "切替"
  animate cdn ..> o_lb : "フェイルオーバー"
  animate o_lb --> o_app1 : "HTTP"
  animate o_lb --> o_app2 : "HTTP" [parallel: true]
  animate o_app1 --> o_cache : "GET"
  animate o_app2 --> o_cache : "GET" [parallel: true]
  animate o_app1 --> o_db : "SQL (読取)"
  animate o_app2 --> o_db : "SQL (読取)" [parallel: true]
  animate o_app1 --> o_q : "ジョブ"
  animate o_app1 --> s3 : "アップロード"
  animate obs --> sre : "アラート"
  animate sre --> runbook : "実行"
  animate runbook ..> dns : "手動切替"
  animate runbook ..> o_db : "昇格"
}
