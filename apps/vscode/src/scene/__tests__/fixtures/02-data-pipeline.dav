title "02 データ基盤: 収集から活用まで"

// Many inputs come together into a few (fan-in) and spread again (fan-out).
// The operations zone sends dashed static control lines to all the others.

group sources "データソース" [color: teal] {
  node appdb "業務DB" [icon: database, sub: "MySQL"]
  node crm "CRM" [icon: external, sub: "Salesforce"]
  node weblog "アクセスログ" [icon: file, sub: "Nginx"]
  node iot "センサー" [icon: device, sub: "MQTT"]
  node saas "広告SaaS" [icon: external, sub: "REST API"]
  node files "CSVファイル" [icon: sheet, sub: "SFTP"]
}

group ingest "取り込み" [color: purple] {
  node cdc "CDC" [icon: logic, sub: "Debezium"]
  node collector "APIコレクター" [icon: function, sub: "Lambda"]
  node stream "ストリーム" [icon: queue, sub: "Kinesis"]
  node loader "バッチローダー" [icon: schedule, sub: "Embulk"]
}

group process "加工" [color: blue] {
  node lake "データレイク" [icon: storage, sub: "S3 / Parquet"]
  node spark "分散処理" [icon: runtime, sub: "Spark"]
  node dbt "変換" [icon: logic, sub: "dbt"]
  node quality "品質検査" [icon: search, sub: "Great Expectations"]
  node feature "特徴量ストア" [icon: cache, sub: "Feast"]
}

group serve "活用" [color: green] {
  node dwh "DWH" [icon: database, sub: "BigQuery"]
  node mart "データマート" [icon: sheet, sub: "部門別"]
  node bi "BIダッシュボード" [icon: monitor, sub: "Looker"]
  node ml "機械学習" [icon: ai, sub: "需要予測"]
  node retl "リバースETL" [icon: webhook, sub: "Hightouch"]
}

group ops "運用・統制" [color: gray] {
  node airflow "ジョブ管理" [icon: schedule, sub: "Airflow"]
  node catalog "データカタログ" [icon: search, sub: "DataHub"]
  node mon "監視" [icon: monitor, sub: "Datadog"]
  node pager "アラート" [icon: chat, sub: "Slack"]
}

step "データ収集とレイク格納" {
  animate appdb --> cdc : "binlog"
  animate cdc --> stream : "変更イベント"
  animate weblog --> stream : "Fluent Bit" [parallel: true]
  animate iot --> stream : "MQTT" [parallel: true]
  animate crm --> collector : "REST"
  animate saas --> collector : "REST" [parallel: true]
  animate files --> loader : "SFTP"
  animate collector --> lake : "JSON"
  animate stream --> lake : "Firehose" [parallel: true]
  animate loader --> lake : "Parquet" [parallel: true]
}

step "加工・変換とDWH構築" {
  static airflow ..> loader : "起動"
  static airflow ..> spark : "起動"
  static airflow ..> dbt : "起動"
  animate lake --> spark : "読み込み"
  animate spark --> quality : "検査"
  animate spark --> feature : "特徴量" [parallel: true]
  animate quality --> dbt : "合格データ"
  animate dbt --> dwh : "モデル"
}

step "分析活用と監視連携" {
  static catalog <.> lake : "メタデータ"
  static catalog <.> dwh : "メタデータ"
  static quality --> mon : "検査結果"
  static airflow --> mon : "ジョブ状態"
  static mon --> pager : "通知"
  animate dwh --> mart : "集計"
  animate mart --> bi : "SQL"
  animate dwh --> ml : "学習データ" [parallel: true]
  animate feature --> ml : "オンライン特徴量"
  animate mart --> retl : "同期"
  animate retl --> crm : "書き戻し"
}
