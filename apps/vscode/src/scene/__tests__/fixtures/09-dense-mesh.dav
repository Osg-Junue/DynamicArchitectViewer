title "09 サービスメッシュ: 辺が密な構成"

// Cross-cutting config & observability links declared via `static`, separate from core runtime flows.

group front "フロント" [color: teal] {
  node web "Web" [icon: browser, sub: "Next.js"]
  node ios "iOS" [icon: mobile, sub: "Swift"]
  node partner "提携API" [icon: external, sub: "B2B"]
}

group sales "販売ドメイン" [color: blue] {
  node gw "ゲートウェイ" [icon: router, sub: "Envoy"]
  node search "検索" [icon: search, sub: "Go"]
  node product "商品" [icon: container, sub: "Go"]
  node price "価格" [icon: container, sub: "Rust"]
  node cart "カート" [icon: container, sub: "Node.js"]
}

group fulfil "受注ドメイン" [color: green] {
  node order "注文" [icon: container, sub: "Java"]
  node payment "決済" [icon: payment, sub: "Java"]
  node stock "在庫" [icon: container, sub: "Go"]
  node ship "配送" [icon: container, sub: "Kotlin"]
  node invoice "請求" [icon: sheet, sub: "Python"]
}

group platform "共通基盤" [color: purple] {
  node authn "認証" [icon: auth, sub: "OIDC"]
  node config "設定配信" [icon: file, sub: "Consul"]
  node bus "イベントバス" [icon: queue, sub: "NATS"]
  node cache "共有キャッシュ" [icon: cache, sub: "Redis"]
  node db "共有DB" [icon: database, sub: "CockroachDB"]
}

group obs "可観測性" [color: orange] {
  node trace "トレース" [icon: monitor, sub: "Tempo"]
  node logs "ログ" [icon: file, sub: "Loki"]
  node metric "メトリクス" [icon: monitor, sub: "Mimir"]
  node dash "ダッシュボード" [icon: screen, sub: "Grafana"]
}

step "商品検索とカート更新" {
  static config ..> gw : "設定"
  static config ..> order : "設定"
  static config ..> payment : "設定"
  static trace --> dash : "参照"
  static logs --> dash : "参照"
  static metric --> dash : "参照"
  animate web --> gw : "HTTPS"
  animate ios --> gw : "HTTPS" [parallel: true]
  animate partner --> gw : "mTLS" [parallel: true]
  animate gw <-> authn : "検証"
  animate gw --> search : "gRPC"
  animate gw --> product : "gRPC" [parallel: true]
  animate gw --> cart : "gRPC" [parallel: true]
  animate search --> product : "gRPC"
  animate product --> price : "gRPC"
  animate cart --> price : "gRPC" [parallel: true]
  animate cart --> stock : "在庫確認"
  animate cart --> cache : "セッション"
  animate product --> cache : "キャッシュ" [parallel: true]
  animate price --> cache : "キャッシュ" [parallel: true]
  animate product --> db : "SQL"
}

step "注文・決済・配送と非同期イベント" {
  static gw ..> trace : "span"
  static order ..> trace : "span"
  static payment ..> trace : "span"
  static cart ..> logs : "ログ"
  static ship ..> logs : "ログ"
  static stock ..> metric : "計測"
  static bus ..> metric : "計測"
  static db ..> metric : "計測"
  animate gw --> order : "gRPC"
  animate order --> payment : "gRPC"
  animate order --> stock : "引当" [parallel: true]
  animate order --> ship : "出荷指示" [parallel: true]
  animate order --> db : "SQL"
  animate payment --> db : "SQL" [parallel: true]
  animate stock --> db : "SQL" [parallel: true]
  animate ship --> db : "SQL" [parallel: true]
  animate payment --> invoice : "請求作成"
  animate invoice --> db : "SQL"
  animate order --> bus : "OrderPlaced"
  animate payment --> bus : "Paid" [parallel: true]
  animate stock --> bus : "StockLow" [parallel: true]
  animate ship --> bus : "Shipped" [parallel: true]
  animate bus --> invoice : "購読"
  animate bus --> search : "索引更新" [parallel: true]
}
