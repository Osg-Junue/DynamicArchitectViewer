dav 1
title "09 サービスメッシュ: 辺が密な構成"

// About 45 edges on 22 nodes: bundles of rails, crossings and little room for labels.

group front "フロント" [color: teal] {
  node web "Web" [icon: browser, sub: "Next.js"]
  node ios "iOS" [icon: mobile, sub: "Swift"]
  node partner "提携API" [icon: external, sub: "B2B"]
}

group sales "販売ドメイン" [color: blue] {
  node gw "ゲートウェイ" [icon: router, sub: "Envoy"]
  node search "検索" [icon: search, sub: "Go"]
  node product "商品" [icon: container, sub: "Go"]
  node price "価格" [icon: container, sub: "Rust"]
  node cart "カート" [icon: container, sub: "Node.js"]
}

group fulfil "受注ドメイン" [color: green] {
  node order "注文" [icon: container, sub: "Java"]
  node payment "決済" [icon: payment, sub: "Java"]
  node stock "在庫" [icon: container, sub: "Go"]
  node ship "配送" [icon: container, sub: "Kotlin"]
  node invoice "請求" [icon: sheet, sub: "Python"]
}

group platform "共通基盤" [color: purple] {
  node authn "認証" [icon: auth, sub: "OIDC"]
  node config "設定配信" [icon: file, sub: "Consul"]
  node bus "イベントバス" [icon: queue, sub: "NATS"]
  node cache "共有キャッシュ" [icon: cache, sub: "Redis"]
  node db "共有DB" [icon: database, sub: "CockroachDB"]
}

group obs "可観測性" [color: orange] {
  node trace "トレース" [icon: monitor, sub: "Tempo"]
  node logs "ログ" [icon: file, sub: "Loki"]
  node metric "メトリクス" [icon: monitor, sub: "Mimir"]
  node dash "ダッシュボード" [icon: screen, sub: "Grafana"]
}

web --> gw : "HTTPS"
ios --> gw : "HTTPS"
partner --> gw : "mTLS"
gw <-> authn : "検証"
gw --> search : "gRPC"
gw --> product : "gRPC"
gw --> cart : "gRPC"
gw --> order : "gRPC"
search --> product : "gRPC"
product --> price : "gRPC"
cart --> price : "gRPC"
cart --> stock : "在庫確認"
cart --> cache : "セッション"
product --> cache : "キャッシュ"
price --> cache : "キャッシュ"
order --> payment : "gRPC"
order --> stock : "引当"
order --> ship : "出荷指示"
order --> bus : "OrderPlaced"
payment --> invoice : "請求作成"
payment --> bus : "Paid"
stock --> bus : "StockLow"
ship --> bus : "Shipped"
bus --> invoice : "購読"
bus --> search : "索引更新"
order --> db : "SQL"
payment --> db : "SQL"
stock --> db : "SQL"
ship --> db : "SQL"
invoice --> db : "SQL"
product --> db : "SQL"
config ..> gw : "設定"
config ..> order : "設定"
config ..> payment : "設定"
gw ..> trace : "span"
order ..> trace : "span"
payment ..> trace : "span"
cart ..> logs : "ログ"
ship ..> logs : "ログ"
stock ..> metric : "計測"
bus ..> metric : "計測"
db ..> metric : "計測"
trace --> dash : "参照"
logs --> dash : "参照"
metric --> dash : "参照"
