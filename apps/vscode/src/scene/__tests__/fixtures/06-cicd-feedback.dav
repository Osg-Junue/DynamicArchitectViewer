title "06 CI/CD: 長い一本道と戻りの辺"

// A long chain, with feedback from its right end back to its left (a cycle).

group dev "開発" [color: teal] {
  node engineer "開発者" [icon: user, sub: "チーム"]
  node ide "エディタ" [icon: terminal, sub: "VS Code"]
  node git "リポジトリ" [icon: file, sub: "GitHub"]
  node review "レビュー" [icon: chat, sub: "Pull Request"]
}

group ci "CI" [color: purple] {
  node runner "ランナー" [icon: runtime, sub: "GitHub Actions"]
  node build "ビルド" [icon: logic, sub: "Docker"]
  node unit "単体テスト" [icon: function, sub: "Vitest"]
  node scan "脆弱性検査" [icon: search, sub: "Trivy"]
  node sbom "SBOM" [icon: file, sub: "CycloneDX"]
}

group stg "検証環境" [color: blue] {
  node registry "レジストリ" [icon: storage, sub: "ECR"]
  node stg_k8s "検証クラスタ" [icon: container, sub: "EKS"]
  node e2e "E2Eテスト" [icon: browser, sub: "Playwright"]
  node approve "承認" [icon: key, sub: "リリース責任者"]
}

group prod "本番環境" [color: green] {
  node argo "GitOps" [icon: runtime, sub: "Argo CD"]
  node canary "カナリア" [icon: lb, sub: "5% → 100%"]
  node prod_k8s "本番クラスタ" [icon: container, sub: "EKS"]
  node rollback "ロールバック" [icon: logic, sub: "自動判定"]
}

group feedback "フィードバック" [color: orange] {
  node metrics "メトリクス" [icon: monitor, sub: "Prometheus"]
  node alert "アラート" [icon: chat, sub: "Slack"]
  node issue "課題管理" [icon: sheet, sub: "GitHub Issues"]
  node post "振り返り" [icon: file, sub: "ポストモーテム"]
}

step "開発とCI検証" {
  animate engineer --> ide : "実装"
  animate ide --> git : "push"
  animate git --> review : "PR作成"
  animate review --> git : "承認・マージ"
  animate git --> runner : "Webhook"
  animate runner --> build : "ジョブ"
  animate runner --> unit : "ジョブ" [parallel: true]
  animate build --> scan : "イメージ"
  animate scan --> sbom : "生成"
  animate unit ..> review : "結果コメント"
  animate scan ..> review : "結果コメント" [parallel: true]
}

step "検証環境への展開と承認" {
  static registry --> argo : "イメージ参照"
  animate build --> registry : "push"
  animate registry --> stg_k8s : "デプロイ"
  animate stg_k8s --> e2e : "対象"
  animate e2e --> approve : "合格"
}

step "本番リリースとフィードバック" {
  static prod_k8s --> metrics : "スクレイプ"
  static canary --> canary : "重み更新"
  animate approve --> argo : "タグ更新"
  animate argo --> canary : "同期"
  animate canary --> prod_k8s : "段階公開"
  animate metrics --> rollback : "エラー率"
  animate rollback --> argo : "差し戻し"
  animate metrics --> alert : "しきい値"
  animate alert --> engineer : "呼び出し"
  animate alert --> issue : "起票" [parallel: true]
  animate issue --> post : "原因分析"
  animate post --> engineer : "改善タスク"
}
