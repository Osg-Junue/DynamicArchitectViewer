title "01 ECサイト: 層構造のマイクロサービス"

// Layers that read from left to right, with one edge back from the data layer (mq --> notify).

group clients "クライアント" [color: teal] {
  node web "Webブラウザ" [icon: browser, sub: "SPA (React)"]
  node app "モバイルアプリ" [icon: mobile, sub: "iOS / Android"]
  node admin "管理画面" [icon: desktop, sub: "社内オペレーター"]
}

group edge "エッジ" [color: purple] {
  node cdn "CDN" [icon: cdn, sub: "CloudFront"]
  node waf "WAF" [icon: firewall, sub: "Bot対策"]
  node gw "APIゲートウェイ" [icon: router, sub: "Kong"]
  node auth "認証" [icon: auth, sub: "OIDC / JWT"]
}

group services "アプリケーション" [color: blue] {
  node bff "BFF" [icon: api, sub: "GraphQL"]
  node catalog "商品サービス" [icon: container, sub: "Go"]
  node cart "カートサービス" [icon: container, sub: "Node.js"]
  node order "注文サービス" [icon: container, sub: "Java"]
  node pay "決済サービス" [icon: payment, sub: "PCI分離"]
  node stock "在庫サービス" [icon: container, sub: "Go"]
  node notify "通知サービス" [icon: mail, sub: "Worker"]
}

group data "データ" [color: green] {
  node pg "注文DB" [icon: database, sub: "PostgreSQL"]
  node es "検索" [icon: search, sub: "OpenSearch"]
  node redis "キャッシュ" [icon: cache, sub: "Redis"]
  node mq "イベントバス" [icon: queue, sub: "Kafka"]
  node s3 "画像ストレージ" [icon: storage, sub: "S3"]
}

group ext "外部サービス" [color: yellow] {
  node psp "決済代行" [icon: external, sub: "Stripe"]
  node carrier "配送業者API" [icon: external, sub: "ヤマト / 佐川"]
  node smtp "メール配信" [icon: mail, sub: "SendGrid"]
}

step "エッジ経由のアクセスと静的配信" {
  animate web --> cdn : "HTTPS"
  animate app --> waf : "HTTPS"
  animate admin --> gw : "VPN"
  animate cdn --> waf : "オリジン転送"
  static cdn --> s3 : "静的配信"
  animate waf --> gw : "検査済み"
  animate gw <-> auth : "トークン検証"
  animate gw --> bff : "GraphQL"
}

step "商品検索とカート操作" {
  animate bff --> catalog : "gRPC"
  animate bff --> cart : "gRPC" [parallel: true]
  animate catalog --> es : "検索クエリ"
  animate catalog --> redis : "キャッシュ" [parallel: true]
  animate cart --> redis : "カート保存"
}

step "注文・決済・出荷とイベント通知" {
  animate bff --> order : "gRPC"
  animate order --> pg : "SQL"
  animate order --> stock : "引当" [parallel: true]
  animate order --> pay : "決済依頼"
  animate pay <-> psp : "Charge API"
  animate stock --> pg : "SQL"
  animate stock --> carrier : "出荷依頼" [parallel: true]
  animate order --> mq : "OrderCreated"
  animate mq --> notify : "購読"
  animate notify --> smtp : "SMTP"
}
