title "07 ゼロトラスト: 入れ子のゾーンと横断する辺"

// Zones inside zones. The security zone is linked to all the others via static telemetry & policy control.

group users "利用者" [color: teal] {
  group staff "社員" [color: teal] {
    node emp_pc "社給PC" [icon: desktop, sub: "Intune管理"]
    node emp_phone "社給スマホ" [icon: mobile, sub: "MDM"]
  }
  group partner "委託先" [color: yellow] {
    node pt_pc "持ち込みPC" [icon: desktop, sub: "非管理"]
    node pt_vdi "VDI" [icon: screen, sub: "仮想デスクトップ"]
  }
}

group access "アクセス制御" [color: purple] {
  node idp "IdP" [icon: auth, sub: "Entra ID"]
  node mfa "多要素認証" [icon: key, sub: "FIDO2"]
  node posture "端末検査" [icon: search, sub: "コンプライアンス"]
  node pdp "ポリシー判定" [icon: logic, sub: "OPA"]
  node proxy "アクセスプロキシ" [icon: router, sub: "ZTNA"]
}

group workloads "業務システム" [color: blue] {
  group k8s "コンテナ基盤" [color: blue] {
    node portal "社内ポータル" [icon: browser, sub: "Next.js"]
    node hr "人事システム" [icon: container, sub: "Java"]
    node expense "経費精算" [icon: container, sub: "Go"]
    node wiki "ナレッジ" [icon: file, sub: "Wiki"]
  }
  group legacy "旧システム" [color: gray] {
    node erp "基幹ERP" [icon: server, sub: "SAP"]
    node host "ホスト連携" [icon: terminal, sub: "3270"]
  }
}

group datazone "データ" [color: green] {
  node hr_db "人事DB" [icon: database, sub: "機密"]
  node fin_db "会計DB" [icon: database, sub: "機密"]
  node doc "文書保管" [icon: storage, sub: "SharePoint"]
  node dlp "DLP" [icon: firewall, sub: "持ち出し検査"]
}

group secops "セキュリティ運用" [color: red] {
  node siem "SIEM" [icon: monitor, sub: "Sentinel"]
  node soar "自動対応" [icon: bot, sub: "SOAR"]
  node vault "秘密情報" [icon: key, sub: "Vault"]
  node pki "証明書発行" [icon: file, sub: "社内CA"]
  node soc "SOC" [icon: users, sub: "24時間"]
}

step "ゼロトラスト認証と業務アクセス" {
  static pki ..> proxy : "証明書"
  static pki ..> emp_pc : "端末証明書"
  static vault ..> hr : "DB資格情報"
  static vault ..> expense : "DB資格情報"
  animate emp_pc --> proxy : "HTTPS"
  animate emp_phone --> proxy : "HTTPS" [parallel: true]
  animate pt_pc --> pt_vdi : "画面転送"
  animate pt_vdi --> proxy : "HTTPS"
  animate proxy <-> pdp : "許可判定"
  animate pdp <-> posture : "端末状態"
  animate pdp <-> idp : "属性"
  animate idp <-> mfa : "チャレンジ"
  animate proxy --> portal : "mTLS"
}

step "業務処理とデータ連携" {
  animate portal --> hr : "REST"
  animate portal --> expense : "REST" [parallel: true]
  animate portal --> wiki : "REST" [parallel: true]
  animate hr --> hr_db : "SQL"
  animate expense --> fin_db : "SQL" [parallel: true]
  animate expense --> erp : "仕訳連携"
  animate erp --> fin_db : "SQL"
  animate erp <-> host : "バッチ" [parallel: true]
  animate wiki --> doc : "Graph API"
  animate doc --> dlp : "検査"
  animate hr_db --> dlp : "監査" [parallel: true]
}

step "セキュリティ監視と自動遮断" {
  static proxy ..> siem : "アクセスログ"
  static idp ..> siem : "認証ログ"
  static dlp ..> siem : "検知"
  static erp ..> siem : "監査ログ"
  animate siem --> soar : "インシデント"
  animate soar --> soc : "エスカレーション"
  animate soar ..> idp : "アカウント停止" [parallel: true]
  animate soar ..> proxy : "遮断" [parallel: true]
}
