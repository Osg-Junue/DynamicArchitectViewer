// Lezer grammar for DynamicArchitectViewer DSL v1.
// Spec: docs/03-specification/dsl-v1.md

@top Document { Header? statement* }

@skip { space | LineComment }

Header { kw<"dav"> Number }

statement { Title | Group | Node | Edge | Step }

Title { kw<"title"> String }

Group { kw<"group"> Identifier Label? Attributes? GroupBody }
GroupBody { "{" (Group | Node)* "}" }

Node { kw<"node"> Identifier Label? Attributes? }

Label { String }

Edge { Identifier Arrow Identifier EdgeLabel? Attributes? }
EdgeLabel { ":" String }

Step { kw<"step"> String StepBody }
StepBody { "{" stepStatement* "}" }

stepStatement { Desc | Focus | State | Animate }
Desc { kw<"desc"> String }
Focus { kw<"focus"> Identifier ("," Identifier)* }
State { kw<"state"> Identifier Attributes }
Animate { kw<"animate"> Identifier Arrow Identifier EdgeLabel? Attributes? AnimateBody? }
AnimateBody { "{" Desc* "}" }

Attributes { "[" (Attribute ("," Attribute)* ","?)? "]" }
Attribute { AttrName ":" value }
AttrName { Identifier | kw<"desc"> }
value { String | Number | Color | Identifier | Boolean }
Boolean { kw<"true"> | kw<"false"> }

kw<term> { @specialize[@name={term}]<Identifier, term> }

@tokens {
  space { @whitespace+ }
  LineComment { "//" ![\n]* }
  Identifier { $[A-Za-z_] $[A-Za-z0-9_]* }
  Number { "-"? @digit+ ("." @digit+)? }
  Color { "#" $[0-9a-zA-Z]+ }
  String { '"' (!["\\\n] | "\\" _)* '"' }
  Arrow { "-->" | "..>" | "<->" | "<.>" }
  "{" "}" "[" "]" "," ":"
}

@detectDelim
